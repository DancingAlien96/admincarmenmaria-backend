# --- Servidor ---
PORT=4000
NODE_ENV=development
# URL del frontend Next.js (para CORS)
FRONTEND_URL=http://localhost:3000

# --- MySQL (Docker) ---
MYSQL_PORT=3306
MYSQL_DATABASE=carmenmaria
MYSQL_USER=carmenmaria
MYSQL_PASSWORD=carmenmaria
MYSQL_ROOT_PASSWORD=rootpassword

# --- Prisma ---
DATABASE_URL="mysql://carmenmaria:carmenmaria@localhost:3306/carmenmaria"

# --- Auth (JWT) ---
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# --- Usuario administrador inicial (seed) ---
ADMIN_EMAIL=admin@enfermeriacarmenmaria.edu.gt
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=Administrador

# --- WooCommerce (Modulo 2 - pagos) ---
WOO_URL=https://enfermeriacarmenmaria.edu.gt
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- SMTP (Modulo 6 - envio de actas a la supervisora) ---
# Ej. Gmail: host=smtp.gmail.com port=587, usuario y "contrasena de aplicacion"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPERVISOR_EMAIL=
