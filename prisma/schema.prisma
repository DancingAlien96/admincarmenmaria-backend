// Esquema de base de datos - Sistema Administrativo Carmen Maria
// Cimientos (usuarios/roles/permisos) + Modulo 1 (Expediente del Estudiante)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Usuarios, roles y permisos por seccion
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN // Acceso total. Puede crear hasta 5 usuarios y definir sus permisos.
  STAFF // Personal con permisos por seccion (editor o lector).
  DOCENTE // Catedratico: ingresa calificaciones (portal docente)
  ESTUDIANTE // Alumno: portal del estudiante (ve solo su informacion)
}

enum ModuleSection {
  STUDENTS // Modulo 1 - Expediente del Estudiante
  PAYMENTS // Modulo 2 - Control de Pagos
  REMINDERS // Modulo 3 - Recordatorios Automaticos
  DASHBOARD // Modulo 4 - Dashboard Financiero
  DIPLOMAS // Modulo 5 - Banca de Diplomas
  ACTAS // Modulo 6 - Gestion de Actas
}

enum PermissionLevel {
  READER // Solo lectura
  EDITOR // Lectura y escritura
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  // Para cuentas de rol ESTUDIANTE: expediente vinculado (portal del alumno).
  studentId    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student          Student?               @relation("StudentPortalUser", fields: [studentId], references: [id])
  permissions      UserPermission[]
  // Auditoria
  createdStudents  Student[]               @relation("StudentCreatedBy")
  statusChanges    StudentStatusHistory[]  @relation("StatusChangedBy")
  uploadedDocs     StudentDocument[]       @relation("DocUploadedBy")
  registeredPayments Payment[]             @relation("PaymentRegisteredBy")
  annulledPayments   Payment[]             @relation("PaymentAnnulledBy")
  registeredExpenses Expense[]             @relation("ExpenseRegisteredBy")
  createdCharges     Charge[]              @relation("ChargeCreatedBy")
  annulledCharges    Charge[]              @relation("ChargeAnnulledBy")
  createdGraduates   Graduate[]            @relation("GraduateCreatedBy")
  createdActas       Acta[]                @relation("ActaCreatedBy")
  docStatusUpdates   StudentDocStatus[]    @relation("DocStatusUpdatedBy")

  @@index([email])
}

model UserPermission {
  id      String          @id @default(cuid())
  userId  String
  section ModuleSection
  level   PermissionLevel @default(READER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Modulo 1 - Expediente del Estudiante
// ----------------------------------------------------------------------------

enum StudentStatus {
  ACTIVO // Cursando (estado inicial al inscribir)
  EGRESADO // Curso completado, migrado a banca de diplomas
  BAJA // Abandono o expulsion, expediente archivado
}

model Student {
  id             String        @id @default(cuid())
  // Correlativo visible del expediente (ej. AE-2025-0147)
  expedienteNumber String?     @unique
  fullName       String
  // Opcional: los estudiantes creados desde un pago aun no tienen DPI.
  // Sigue siendo unico cuando esta presente (MySQL permite varios NULL).
  dpi            String?       @unique // Identificacion oficial, no repetible
  birthDate      DateTime?
  // Direccion
  department     String?
  municipality   String?
  address        String?
  // Contacto
  phonePrimary   String?
  phoneAlt       String?
  email          String?
  // Sede en la que se inscribio (Chiquimula / Morales Izabal). Derivada del
  // pago de admision de WooCommerce; editable a mano.
  sede           String?
  // Estado y trazabilidad
  status         StudentStatus @default(ACTIVO)
  enrollmentDate DateTime      @default(now())
  archived       Boolean       @default(false) // Nunca se elimina, solo se archiva
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdBy     User?                  @relation("StudentCreatedBy", fields: [createdById], references: [id])
  guardians     Guardian[]
  documents     StudentDocument[]
  statusHistory StudentStatusHistory[]
  payments      Payment[]
  charges       Charge[]
  graduate      Graduate?
  whatsappMessages WhatsappMessage[]
  portalUser    User?                  @relation("StudentPortalUser")
  docStatuses   StudentDocStatus[]

  @@index([dpi])
  @@index([status])
  @@index([fullName])
  @@index([sede])
}

// Persona responsable del estudiante (papa, mama, hermano, etc.)
model Guardian {
  id           String  @id @default(cuid())
  studentId    String
  name         String
  relationship String? // Parentesco
  phone        String?
  email        String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum DocumentType {
  DPI
  PARTIDA_NACIMIENTO
  FOTOGRAFIA
  CODIGO_BASICO
  CERTIFICADO_BASICO
  DIPLOMA_PREVIO
  CARTA_RECOMENDACION
  OTRO
}

// Documentos digitales: la BD guarda solo la referencia (URL de UploadThing)
model StudentDocument {
  id           String       @id @default(cuid())
  studentId    String
  type         DocumentType
  fileName     String
  fileUrl      String       @db.Text // URL en la nube (UploadThing)
  fileKey      String? // key de UploadThing para poder borrar el archivo
  uploadedById String?
  createdAt    DateTime     @default(now())

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("DocUploadedBy", fields: [uploadedById], references: [id])

  @@index([studentId])
}

// Catalogo de documentos requeridos del expediente (checklist). Editable por
// el admin: puede agregar, renombrar, reordenar o desactivar documentos.
model DocRequirement {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statuses StudentDocStatus[]

  @@index([active])
}

// Estado de un documento requerido para un estudiante (entregado / pendiente).
model StudentDocStatus {
  id            String    @id @default(cuid())
  studentId     String
  requirementId String
  delivered     Boolean   @default(false)
  receivedAt    DateTime?
  notes         String?   @db.Text
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requirement DocRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  updatedBy   User?          @relation("DocStatusUpdatedBy", fields: [updatedById], references: [id])

  @@unique([studentId, requirementId])
  @@index([studentId])
  @@index([requirementId])
}

// Historial de cambios de estado (cada cambio registra fecha y motivo)
model StudentStatusHistory {
  id           String        @id @default(cuid())
  studentId    String
  fromStatus   StudentStatus?
  toStatus     StudentStatus
  reason       String?       @db.Text
  changedById  String?
  createdAt    DateTime      @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([studentId])
}

// ----------------------------------------------------------------------------
// Modulo 2 - Control de Pagos
// ----------------------------------------------------------------------------

enum FeeCategory {
  INSCRIPCION // Pago unico al ingresar
  MENSUALIDAD // Cobro periodico
  MATERIALES // Materiales / insumos
  REPOSICION_DIPLOMA // Reposicion de titulo
  OTROS // Cobros especiales o imprevistos
}

// Tipo de cuota configurable por el administrador (monto sin tocar codigo)
model FeeType {
  id        String      @id @default(cuid())
  name      String // "Mensualidad Teoria", "Inscripcion", etc.
  category  FeeCategory
  amount    Decimal     @db.Decimal(10, 2) // monto por defecto
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  payments Payment[]
  charges  Charge[]

  @@index([active])
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
  TARJETA // normalmente via WooCommerce / Tilopay
}

enum PaymentSource {
  MANUAL // registrado por el personal
  WOOCOMMERCE // sincronizado desde la tienda
}

enum PaymentStatus {
  ACTIVO
  ANULADO // no se elimina; se anula con trazabilidad
}

model Payment {
  id        String        @id @default(cuid())
  // Vinculo con el estudiante (puede faltar en pagos de Woo aun sin vincular)
  studentId String?
  feeTypeId String?
  // Cargo (cuota asignada) que este pago cubre, si aplica
  chargeId  String?
  concept   String // descripcion del cobro
  amount    Decimal       @db.Decimal(10, 2)
  discount  Decimal       @default(0) @db.Decimal(10, 2) // beca / descuento aplicado
  method    PaymentMethod
  source    PaymentSource @default(MANUAL)
  status    PaymentStatus @default(ACTIVO)
  paidAt    DateTime      @default(now())

  // Comprobante escaneado / fotografiado (UploadThing)
  receiptUrl String? @db.Text
  receiptKey String?

  // Datos de WooCommerce (la tienda no tiene DPI; se vincula por correo/nombre)
  wooOrderId Int?    @unique
  payerName  String?
  payerEmail String?
  // Sede a la que corresponde el pago, si WooCommerce la trae en el producto.
  sede       String?

  // Trazabilidad
  registeredById String?
  annulledAt     DateTime?
  annulledById   String?
  annulReason    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student      Student? @relation(fields: [studentId], references: [id])
  feeType      FeeType? @relation(fields: [feeTypeId], references: [id])
  charge       Charge?  @relation(fields: [chargeId], references: [id])
  registeredBy User?    @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])
  annulledBy   User?    @relation("PaymentAnnulledBy", fields: [annulledById], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([source])
  @@index([paidAt])
  @@index([chargeId])
}

// ----------------------------------------------------------------------------
// Cuotas asignadas (cargos) - lo que cada estudiante DEBE pagar.
// Base para mora e "ingreso esperado" del dashboard.
// ----------------------------------------------------------------------------

enum ChargeStatus {
  PENDIENTE // Aun sin pagar (o pago parcial)
  PAGADO // Cubierto en su totalidad
  ANULADO // Cancelado, no cuenta para mora
}

model Charge {
  id        String       @id @default(cuid())
  studentId String
  feeTypeId String?
  concept   String
  amount    Decimal      @db.Decimal(10, 2)
  dueDate   DateTime // fecha de vencimiento
  status    ChargeStatus @default(PENDIENTE)

  // Trazabilidad
  createdById  String?
  annulledAt   DateTime?
  annulledById String?
  annulReason  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeType   FeeType?  @relation(fields: [feeTypeId], references: [id])
  createdBy User?     @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  annulledBy User?    @relation("ChargeAnnulledBy", fields: [annulledById], references: [id])
  payments  Payment[]

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

// Plan de cuotas GENERAL (plantilla). El admin lo define una sola vez; al
// aplicarlo a un estudiante se crean sus Charge individuales. monthOffset es el
// numero de meses desde el mes de inicio (Admision=0, Cuota 1=1, ..., Tramite=13).
model CuotaPlanItem {
  id          String   @id @default(cuid())
  concept     String
  amount      Decimal  @db.Decimal(10, 2)
  monthOffset Int      @default(0)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// ----------------------------------------------------------------------------
// Modulo 5 - Banca de Diplomas (Egresados)
// Repositorio digital de diplomas. Se crea al migrar un estudiante a EGRESADO.
// ----------------------------------------------------------------------------

model Graduate {
  id            String   @id @default(cuid())
  // Vinculo opcional al expediente de origen (1 a 1). Puede ser null si se
  // registra un egresado historico sin expediente en el sistema.
  studentId     String?  @unique
  fullName      String
  dpi           String?  @unique // Identificacion oficial (opcional)
  email         String?
  phone         String?
  mspasCode     String? // Codigo de MSPAS del egresado
  diplomaNumber String   @unique // Correlativo unico e irrepetible
  graduationDate DateTime
  // Archivo del diploma escaneado (UploadThing): solo guardamos la referencia
  diplomaUrl    String?  @db.Text
  diplomaKey    String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   Student? @relation(fields: [studentId], references: [id])
  createdBy User?    @relation("GraduateCreatedBy", fields: [createdById], references: [id])
  letters   RecommendationLetter[]

  @@index([fullName])
  @@index([dpi])
  @@index([diplomaNumber])
}

// Cartas de recomendacion emitidas (varia fecha/nombre/DPI + firma digital).
// Guardamos cada emision para trazabilidad.
model RecommendationLetter {
  id          String   @id @default(cuid())
  graduateId  String
  issueDate   DateTime
  // Texto/notas opcionales especificas de esta carta
  notes       String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  graduate Graduate @relation(fields: [graduateId], references: [id], onDelete: Cascade)

  @@index([graduateId])
}

// ----------------------------------------------------------------------------
// Modulo 6 - Gestion de Actas de calificaciones
// Acta grupal: lista a los estudiantes de una fase con sus punteos.
// ----------------------------------------------------------------------------

// Plantilla reutilizable de acta: cuerpo con marcadores ({{...}}, {{tabla}},
// {{lista}}) que el admin gestiona y reutiliza al crear actas.
model ActaTemplate {
  id        String   @id @default(cuid())
  name      String   // ej. "Calificaciones", "Inauguracion"
  title     String?  // titulo por defecto del acta
  body      String   @db.Text // cuerpo con marcadores
  columns   Json?    // encabezados de tabla por defecto (string[])
  signers   Json?    // firmantes por defecto [{name, role}]
  vars      Json?    // variables por defecto {clave: valor}
  block     String?  // "tabla" | "lista" | null (que bloque usa)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Acta unificada y configurable. El cuerpo es texto libre con marcadores;
// el sistema solo garantiza el formato oficial (membrete, firma, sello).
model Acta {
  id         String    @id @default(cuid())
  actaNumber String    // No. de acta (lo define el admin)
  folios     String?   // No. de folios correspondiente
  title      String?   // titulo / tipo de acta
  actaDate   DateTime  // Fecha del acto/evaluacion
  closeDate  DateTime? // Fecha en que se extiende/remite el acta
  city       String    @default("Chiquimula")
  department String    @default("Chiquimula")
  body       String    @db.Text // snapshot del cuerpo final con marcadores
  vars       Json?     // variables {clave: valor}
  columns    Json?     // encabezados de tabla (string[])
  rows       Json?     // filas [{name, value}] para {{tabla}}/{{lista}}
  signers    Json?     // firmantes [{name, role}]
  notes      String?   @db.Text
  templateId String?   // plantilla de origen (informativo)

  // Trazabilidad del envio a la supervisora
  sentAt DateTime?
  sentTo String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("ActaCreatedBy", fields: [createdById], references: [id])

  @@index([actaDate])
}

// Un renglon del acta: estudiante + punteo. Se guarda el nombre por si el
// expediente cambia luego (el acta es un documento historico).

// ----------------------------------------------------------------------------
// Modulo 4 - Dashboard Financiero (Egresos)
// Los ingresos provienen del modelo Payment. Aqui solo los egresos/gastos.
// ----------------------------------------------------------------------------

enum ExpenseCategory {
  SALARIOS // Salarios y honorarios del personal
  INSUMOS // Insumos y materiales educativos
  SERVICIOS // Agua, electricidad, internet
  MANTENIMIENTO // Mantenimiento de instalaciones
  ADMINISTRATIVOS // Gastos administrativos y papeleria
  IMPREVISTOS // Imprevistos
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  concept     String
  amount      Decimal         @db.Decimal(10, 2)
  spentAt     DateTime        @default(now())
  // Comprobante opcional (UploadThing)
  receiptUrl  String?         @db.Text
  receiptKey  String?
  notes       String?         @db.Text

  registeredById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registeredBy User? @relation("ExpenseRegisteredBy", fields: [registeredById], references: [id])

  @@index([category])
  @@index([spentAt])
}

// ----------------------------------------------------------------------------
// Modulo 3 - WhatsApp (bot de dudas + notificaciones) via YCloud
// ----------------------------------------------------------------------------

enum WaDirection {
  INBOUND // mensaje que ENTRA (lo envia el usuario)
  OUTBOUND // mensaje que SALE (lo envia el sistema)
}

enum WaStatus {
  RECEIVED // entrante recibido
  SENT // saliente enviado a YCloud
  DELIVERED // entregado
  READ // leido
  FAILED // fallo el envio
}

// Log de todos los mensajes (entrantes y salientes). El documento lo exige:
// destinatario, fecha/hora, canal y estado del envio.
model WhatsappMessage {
  id          String      @id @default(cuid())
  direction   WaDirection
  phone       String // E.164 del contacto (el usuario)
  body        String      @db.Text
  status      WaStatus
  // Tipo de notificacion saliente (recordatorio, confirmacion, etc.) o "bot"/"manual"
  kind        String?
  // Referencias opcionales
  studentId   String?
  wamid       String? // id del mensaje en WhatsApp
  error       String?     @db.Text
  createdAt   DateTime    @default(now())

  student Student? @relation(fields: [studentId], references: [id])

  @@index([phone])
  @@index([direction])
  @@index([createdAt])
}

// Configuracion del bot (una sola fila). Base de conocimiento editable + interruptor.
model BotConfig {
  id            Int      @id @default(1)
  enabled       Boolean  @default(true) // responder con IA automaticamente
  knowledgeBase String   @db.Text // info de la academia para la IA
  systemPrompt  String?  @db.Text // instrucciones extra opcionales
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Catedraticos (personal docente) - registro tipo CV. Solo admin.
// ----------------------------------------------------------------------------

enum TeacherRole {
  PRACTICA_HOSPITALARIA // Docente de practica hospitalaria
  PRACTICA_COMUNITARIA // Docente de practica comunitaria
  TEORIA // Docente de teoria
}

enum TeacherDocType {
  CV
  DPI
  TITULO
  COLEGIADO
  OTRO
}

model Teacher {
  id           String        @id @default(cuid())
  fullName     String
  dpi          String?       @unique
  phone        String?
  email        String?
  // Datos profesionales
  title        String? // titulo / profesion
  collegiate   String? // numero de colegiado activo
  specialty    String?
  notes        String?       @db.Text
  active       Boolean       @default(true)
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Un catedratico puede tener varios roles (tabla pivote: MySQL no soporta enum[])
  roles     TeacherRoleAssignment[]
  documents TeacherDocument[]

  @@index([fullName])
}

// Asignacion de rol a catedratico (permite varios roles por persona).
model TeacherRoleAssignment {
  id        String      @id @default(cuid())
  teacherId String
  role      TeacherRole

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, role])
  @@index([teacherId])
}

model TeacherDocument {
  id        String         @id @default(cuid())
  teacherId String
  type      TeacherDocType
  fileName  String
  fileUrl   String         @db.Text
  fileKey   String?
  createdAt DateTime       @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

// ----------------------------------------------------------------------------
// Acta de Inauguracion (cohorte de un nuevo ciclo). Distinta a las actas de
// calificaciones. Guarda los datos variables + la lista de alumnos (snapshot).
// ----------------------------------------------------------------------------


// ----------------------------------------------------------------------------
// Invitaciones al portal del alumno. El admin genera un link único (token):
//  - Con studentId: ACTIVA el acceso de un expediente existente (solo contraseña).
//  - Sin studentId: INSCRIPCIÓN nueva (crea expediente + cuenta).
// ----------------------------------------------------------------------------
model PortalInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  studentId   String? // si viene, es activación de un expediente existente
  prefillName String? // nombre sugerido (opcional) para inscripción nueva
  sede        String?
  cohorteYear Int?
  status      String    @default("PENDING") // PENDING | USED | REVOKED
  usedAt      DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([status])
}

// ----------------------------------------------------------------------------
// Firmas del personal (catalogo administrable desde el panel). Cada acta
// congela la firma con la que se emitio (guarda su key en los signers).
// ----------------------------------------------------------------------------
model Signatory {
  id           String   @id @default(cuid())
  name         String // ej. "Lic. Héctor Manuel Sarmiento Reyes"
  role         String // ej. "Secretario", "Directora Técnica"
  sede         String? // opcional: Chiquimula / Morales Izabal
  signatureKey String // archivo de la firma en /uploads
  signatureUrl String   @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}
